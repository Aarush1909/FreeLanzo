// FreeLanzo Phase 3.1 — private accounts, private editable portfolios,
// opt-in read-only public freelancer pages, and public project snapshots.
// Publish in Firebase Console -> freelanzo-82 -> Firestore -> Rules.
// If you already added rules for later phases, merge them; don't overwrite.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function freelancerOwner(uid) {
      return isOwner(uid) &&
        get(/databases/$(database)/documents/users/$(uid)).data.role == 'freelancer';
    }
    function validAvatar(value) {
      return value is string && value.size() <= 700 &&
        (value == '' || value.matches('https://res[.]cloudinary[.]com/[A-Za-z0-9_-]+/image/upload/.*'));
    }
    function validProfileFields() {
      return request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 2 &&
        request.resource.data.displayName.size() <= 80 &&
        request.resource.data.get('headline', '') is string &&
        request.resource.data.get('headline', '').size() <= 110 &&
        request.resource.data.get('location', '') is string &&
        request.resource.data.get('location', '').size() <= 80 &&
        request.resource.data.get('bio', '') is string &&
        request.resource.data.get('bio', '').size() <= 800 &&
        request.resource.data.get('skills', '') is string &&
        request.resource.data.get('skills', '').size() <= 180 &&
        request.resource.data.get('category', '') is string &&
        request.resource.data.get('category', '').size() <= 60 &&
        validAvatar(request.resource.data.get('avatarURL', '')) &&
        request.resource.data.get('experienceLevel', '') in ['', 'Beginner', 'Intermediate', 'Expert'] &&
        request.resource.data.get('availability', '') in ['', 'Available', 'Busy'] &&
        request.resource.data.updatedAt is timestamp;
    }
    function validPortfolio(data) {
      return data.title is string &&
        data.title.size() > 0 && data.title.size() <= 90 &&
        data.category is string &&
        data.category.size() > 0 && data.category.size() <= 60 &&
        data.description is string &&
        data.description.size() > 0 && data.description.size() <= 700 &&
        data.projectUrl is string && data.projectUrl.size() <= 500 &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function portfolioKeys() {
      return ['title', 'category', 'description', 'projectUrl', 'createdAt', 'updatedAt'];
    }
    function validPublicProfile(uid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'headline', 'bio', 'location', 'skills',
          'category', 'avatarURL', 'experienceLevel', 'availability', 'published', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'uid', 'displayName', 'headline', 'bio', 'location', 'skills',
          'category', 'avatarURL', 'experienceLevel', 'availability', 'published', 'updatedAt'
        ]) &&
        request.resource.data.uid == uid &&
        request.resource.data.published == true &&
        validProfileFields();
    }

    match /users/{uid} {
      // Private account profile. No directory/list queries and no reads by others.
      allow get: if isOwner(uid);
      allow list: if false;
      // Preserve the original Phase 2 account creation schema and immutable role.
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'provider', 'photoURL',
          'createdAt', 'termsAcceptedAt', 'termsVersion'
        ]) &&
        request.resource.data.keys().hasAll([
          'uid', 'email', 'displayName', 'role', 'provider', 'photoURL',
          'createdAt', 'termsAcceptedAt', 'termsVersion'
        ]) &&
        request.resource.data.uid == uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.email is string &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() <= 80 &&
        request.resource.data.role in ['freelancer', 'client'] &&
        request.resource.data.provider in ['password', 'google.com'] &&
        request.resource.data.photoURL is string &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.termsAcceptedAt is timestamp &&
        request.resource.data.termsVersion == '2026-11-14';
      // Only profile fields, including the opted-in custom photo, may be changed.
      allow update: if isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'headline', 'bio', 'location', 'skills', 'category',
          'avatarURL', 'experienceLevel', 'availability', 'updatedAt'
        ]) && validProfileFields();
      // Account deletion is owner-only. Nested docs must be removed first;
      // Firestore does not cascade deletes to subcollections.
      allow delete: if isOwner(uid);

      match /savedFreelancers/{freelancerUid} {
        // Only clients save private bookmarks. No one can read another
        // client's saved list, and users can't spoof somebody else's UID.
        allow get: if isOwner(uid);
        allow list: if isOwner(uid) && request.query.limit <= 100;
        allow create: if isOwner(uid) &&
          get(/databases/$(database)/documents/users/$(uid)).data.role == 'client' &&
          request.resource.data.keys().hasOnly(['freelancerUid', 'createdAt']) &&
          request.resource.data.keys().hasAll(['freelancerUid', 'createdAt']) &&
          request.resource.data.freelancerUid == freelancerUid &&
          request.resource.data.createdAt is timestamp &&
          exists(/databases/$(database)/documents/publicFreelancers/$(freelancerUid)) &&
          get(/databases/$(database)/documents/publicFreelancers/$(freelancerUid)).data.published == true;
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      match /portfolios/{projectId} {
        allow get: if isOwner(uid);
        allow list: if isOwner(uid) && request.query.limit <= 100;
        allow create: if freelancerOwner(uid) &&
          request.resource.data.keys().hasOnly(portfolioKeys()) &&
          request.resource.data.keys().hasAll(portfolioKeys()) &&
          validPortfolio(request.resource.data);
        allow update: if freelancerOwner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'category', 'description', 'projectUrl', 'updatedAt'
          ]) && validPortfolio(request.resource.data);
        allow delete: if freelancerOwner(uid);
      }
    }

    match /publicFreelancers/{uid} {
      // Public profile documents are deliberately limited to safe, opt-in fields.
      // A signed-in user can read only published freelancers, plus their own.
      allow get: if isOwner(uid) || (signedIn() && resource.data.published == true);
      allow list: if signedIn() && request.query.limit <= 100 &&
        resource.data.published == true;
      allow create, update: if freelancerOwner(uid) && validPublicProfile(uid);
      allow delete: if freelancerOwner(uid);

      match /projects/{projectId} {
        // Read copies, NOT private editable projects. Withdrawing publication
        // immediately revokes outside reads, even if copied documents remain.
        allow get: if isOwner(uid) || (signedIn() &&
          get(/databases/$(database)/documents/publicFreelancers/$(uid)).data.published == true);
        allow list: if signedIn() && request.query.limit <= 100 &&
          (isOwner(uid) ||
            get(/databases/$(database)/documents/publicFreelancers/$(uid)).data.published == true);
        allow create, update: if freelancerOwner(uid) &&
          request.resource.data.keys().hasOnly(portfolioKeys()) &&
          request.resource.data.keys().hasAll(portfolioKeys()) &&
          validPortfolio(request.resource.data);
        allow delete: if freelancerOwner(uid);
      }
    }

    // Phase 4.1: private text conversations, atomic unread counters and immutable offers.
    // getAfter() verifies that a chat message and its updated inbox preview
    // are committed in the same Firestore batch. The rules also prevent
    // changing the other participant's unread count during read acknowledgement.
    function conversation(cid) {
      return get(/databases/$(database)/documents/conversations/$(cid)).data;
    }
    function isConversationMember(cid) {
      return signedIn() && request.auth.uid in conversation(cid).memberUids;
    }
    function validUnreadNumbers(data) {
      return data.get('clientUnread', 0) is int &&
        data.get('freelancerUnread', 0) is int &&
        data.get('clientUnread', 0) >= 0 &&
        data.get('freelancerUnread', 0) >= 0 &&
        data.get('clientUnread', 0) <= 999999 &&
        data.get('freelancerUnread', 0) <= 999999;
    }
    function validConversationIdentity(cid) {
      return request.resource.data.keys().hasOnly([
        'clientUid', 'freelancerUid', 'memberUids', 'clientName', 'freelancerName',
        'createdAt', 'updatedAt', 'lastMessage', 'lastMessageId', 'lastSenderUid',
        'clientUnread', 'freelancerUnread'
      ]) &&
      request.resource.data.keys().hasAll([
        'clientUid', 'freelancerUid', 'memberUids', 'clientName', 'freelancerName',
        'createdAt', 'updatedAt', 'lastMessage', 'lastMessageId', 'lastSenderUid',
        'clientUnread', 'freelancerUnread'
      ]) &&
      request.resource.data.clientUid == request.auth.uid &&
      request.resource.data.clientUid != request.resource.data.freelancerUid &&
      cid == request.resource.data.clientUid + '_' + request.resource.data.freelancerUid &&
      request.resource.data.memberUids == [request.resource.data.clientUid, request.resource.data.freelancerUid] &&
      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'client' &&
      exists(/databases/$(database)/documents/publicFreelancers/$(request.resource.data.freelancerUid)) &&
      get(/databases/$(database)/documents/publicFreelancers/$(request.resource.data.freelancerUid)).data.published == true &&
      request.resource.data.clientName is string &&
      request.resource.data.clientName.size() > 0 && request.resource.data.clientName.size() <= 80 &&
      request.resource.data.freelancerName is string &&
      request.resource.data.freelancerName.size() > 0 && request.resource.data.freelancerName.size() <= 80 &&
      request.resource.data.createdAt == request.time &&
      request.resource.data.updatedAt == request.time &&
      request.resource.data.lastMessage == '' &&
      request.resource.data.lastMessageId == '' &&
      request.resource.data.lastSenderUid == '' &&
      request.resource.data.clientUnread == 0 &&
      request.resource.data.freelancerUnread == 0;
    }
    function validReadReceipt(cid) {
      return isConversationMember(cid) && validUnreadNumbers(request.resource.data) &&
        (
          (request.auth.uid == resource.data.clientUid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientUnread']) &&
           request.resource.data.get('clientUnread', 0) == 0) ||
          (request.auth.uid == resource.data.freelancerUid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['freelancerUnread']) &&
           request.resource.data.get('freelancerUnread', 0) == 0)
        );
    }
    function validSendPreview(cid) {
      return isConversationMember(cid) &&
        validUnreadNumbers(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageId', 'lastSenderUid', 'updatedAt',
          'clientUnread', 'freelancerUnread'
        ]) &&
        request.resource.data.lastMessage is string &&
        request.resource.data.lastMessage.size() > 0 &&
        request.resource.data.lastMessage.size() <= 160 &&
        request.resource.data.lastMessageId is string &&
        request.resource.data.lastMessageId.size() > 0 &&
        request.resource.data.lastMessageId.size() <= 150 &&
        request.resource.data.lastSenderUid == request.auth.uid &&
        request.resource.data.updatedAt == request.time &&
        getAfter(/databases/$(database)/documents/conversations/$(cid)/messages/$(request.resource.data.lastMessageId)).data.senderUid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/conversations/$(cid)/messages/$(request.resource.data.lastMessageId)).data.createdAt == request.time &&
        (
          (request.auth.uid == resource.data.clientUid &&
           request.resource.data.get('clientUnread', 0) == resource.data.get('clientUnread', 0) &&
           request.resource.data.get('freelancerUnread', 0) == resource.data.get('freelancerUnread', 0) + 1) ||
          (request.auth.uid == resource.data.freelancerUid &&
           request.resource.data.get('freelancerUnread', 0) == resource.data.get('freelancerUnread', 0) &&
           request.resource.data.get('clientUnread', 0) == resource.data.get('clientUnread', 0) + 1)
        );
    }
    function validChatMessage(cid, messageId) {
      return request.resource.data.keys().hasOnly([
        'senderUid', 'kind', 'text', 'contractId', 'createdAt'
      ]) && request.resource.data.keys().hasAll([
        'senderUid', 'kind', 'text', 'contractId', 'createdAt'
      ]) &&
      request.resource.data.senderUid == request.auth.uid &&
      request.resource.data.kind in ['text', 'contract'] &&
      request.resource.data.createdAt == request.time &&
      request.resource.data.text is string &&
      request.resource.data.text.size() <= 2000 &&
      request.resource.data.contractId is string &&
      request.resource.data.contractId.size() <= 150 &&
      getAfter(/databases/$(database)/documents/conversations/$(cid)).data.lastMessageId == messageId &&
      getAfter(/databases/$(database)/documents/conversations/$(cid)).data.lastSenderUid == request.auth.uid &&
      getAfter(/databases/$(database)/documents/conversations/$(cid)).data.updatedAt == request.time &&
      ((request.resource.data.kind == 'text' &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.contractId == '') ||
       (request.resource.data.kind == 'contract' &&
        request.auth.uid == conversation(cid).clientUid &&
        request.resource.data.contractId.size() > 0 &&
        request.resource.data.text == 'Work offer' &&
        getAfter(/databases/$(database)/documents/conversations/$(cid)/contracts/$(request.resource.data.contractId)).data.clientUid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/conversations/$(cid)/contracts/$(request.resource.data.contractId)).data.createdAt == request.time));
    }
    function validWorkOffer(cid) {
      return request.resource.data.keys().hasOnly([
        'clientUid', 'freelancerUid', 'companyName', 'amount', 'currency', 'days',
        'startTime', 'endTime', 'timezone', 'workDescription', 'deadline',
        'paymentTerms', 'paymentDetails', 'signatureMime', 'signatureSize',
        'signatureData', 'status', 'createdAt', 'respondedAt'
      ]) && request.resource.data.keys().hasAll([
        'clientUid', 'freelancerUid', 'companyName', 'amount', 'currency', 'days',
        'startTime', 'endTime', 'timezone', 'workDescription', 'deadline',
        'paymentTerms', 'paymentDetails', 'signatureMime', 'signatureSize',
        'signatureData', 'status', 'createdAt', 'respondedAt'
      ]) &&
      request.auth.uid == conversation(cid).clientUid &&
      request.resource.data.clientUid == conversation(cid).clientUid &&
      request.resource.data.freelancerUid == conversation(cid).freelancerUid &&
      request.resource.data.companyName is string &&
      request.resource.data.companyName.size() >= 2 && request.resource.data.companyName.size() <= 100 &&
      request.resource.data.amount is number &&
      request.resource.data.amount > 0 && request.resource.data.amount <= 1000000000 &&
      request.resource.data.currency == 'INR' &&
      request.resource.data.days is list && request.resource.data.days.size() > 0 && request.resource.data.days.size() <= 7 &&
      request.resource.data.days.hasOnly(['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']) &&
      request.resource.data.startTime is string &&
      request.resource.data.startTime.matches('([01][0-9]|2[0-3]):[0-5][0-9]') &&
      request.resource.data.endTime is string &&
      request.resource.data.endTime.matches('([01][0-9]|2[0-3]):[0-5][0-9]') &&
      request.resource.data.startTime < request.resource.data.endTime &&
      request.resource.data.timezone is string &&
      request.resource.data.timezone.size() > 0 && request.resource.data.timezone.size() <= 50 &&
      request.resource.data.workDescription is string &&
      request.resource.data.workDescription.size() >= 10 &&
      request.resource.data.workDescription.size() <= 1600 &&
      request.resource.data.deadline is string &&
      request.resource.data.deadline.matches('20[0-9]{2}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])') &&
      request.resource.data.paymentTerms in ['completion', 'milestones', 'weekly', 'upfront'] &&
      request.resource.data.paymentDetails is string &&
      request.resource.data.paymentDetails.size() <= 500 &&
      (request.resource.data.paymentTerms != 'milestones' || request.resource.data.paymentDetails.size() >= 5) &&
      request.resource.data.signatureMime in ['image/jpeg', 'image/png', 'image/webp'] &&
      request.resource.data.signatureSize is int &&
      request.resource.data.signatureSize > 0 && request.resource.data.signatureSize <= 30000 &&
      request.resource.data.signatureData is string &&
      request.resource.data.signatureData.size() <= 41000 &&
      request.resource.data.signatureData.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+') &&
      request.resource.data.status == 'pending' &&
      request.resource.data.createdAt == request.time &&
      request.resource.data.respondedAt == null;
    }

    match /conversations/{cid} {
      // The client is allowed to check for a missing deterministic conversation.
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.memberUids);
      allow list: if signedIn() && request.query.limit <= 70 && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn() && validConversationIdentity(cid);
      allow update: if validReadReceipt(cid) || validSendPreview(cid);
      allow delete: if false;

      match /messages/{messageId} {
        allow get: if isConversationMember(cid);
        allow list: if isConversationMember(cid) && request.query.limit <= 120;
        allow create: if isConversationMember(cid) && validChatMessage(cid, messageId);
        allow update, delete: if false;
      }
      match /contracts/{contractId} {
        allow get: if isConversationMember(cid);
        allow list: if isConversationMember(cid) && request.query.limit <= 100;
        allow create: if isConversationMember(cid) && validWorkOffer(cid);
        // After submission the contract's terms and signature are immutable.
        // Freelancer may accept/decline; client may cancel while pending.
        allow update: if isConversationMember(cid) &&
          resource.data.status == 'pending' &&
          ((request.auth.uid == resource.data.freelancerUid &&
            request.resource.data.status in ['accepted', 'declined']) ||
           (request.auth.uid == resource.data.clientUid &&
            request.resource.data.status == 'cancelled')) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']) &&
          request.resource.data.respondedAt == request.time;
        allow delete: if false;
      }
    }

    // Default deny any other collections, including unknown nested data.
    match /{document=**} { allow read, write: if false; }
  }
}
